DATABASE_URL=sqlite:///./users.db
FRONTEND_URL=http://localhost:5173
# DEBUG shows extra detail (e.g. search paging); INFO is the normal level.
LOG_LEVEL=INFO
# true prints every SQL statement (debugging only: noisy, and shows query values).
LOG_SQL=false

# Signs login tokens. Must be at least 32 characters, random, and never committed.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=30

# Auth cookie is Secure (HTTPS only; browsers treat localhost as secure).
# Set to false only if your browser refuses the cookie on plain http.
COOKIE_SECURE=true

# Webhooks are never sent to private (10/8, 172.16/12, 192.168/16, fc00::/7) or
# link-local (169.254/16, fe80::/10) addresses: that would let an admin reach
# internal services (SSRF). Loopback (localhost, 127.0.0.0/8, ::1) is blocked too,
# unless this is true. Set it to true ONLY on your own machine, for the demo
# receiver on http://localhost:9000/webhooks. Private and link-local stay blocked.
ALLOW_LOCAL_WEBHOOKS=false
